<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>../ScreenDash/Assets/screendash.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../ScreenDash/Contracts.cs" Link="Contracts.cs" />
    <Compile Include="../ScreenDash/MainForm.cs" Link="MainForm.cs" />
    <Compile Include="../ScreenDash/RecordingEstimates.cs" Link="RecordingEstimates.cs" />
  </ItemGroup>
</Project>
